{
  "name": "tora",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tora/web dev",
    "app": "pnpm build && pnpm --filter @tora/web start -H 0.0.0.0",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "crawl": "node scripts/crawl.mjs",
    "perf": "node scripts/perf.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && node scripts/typecheck-collectors.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tora/db generate",
    "db:migrate": "pnpm --filter @tora/db migrate",
    "db:seed": "pnpm --filter @tora/db seed",
    "collect": "pnpm --filter @tora/collector-sdk collect",
    "collect:request": "pnpm --silent --filter @tora/db collect-request",
    "collect:log": "d=${TORA_STATE_DIR:-$(sed -n 's/^TORA_STATE_DIR=//p' .env 2>/dev/null | tail -n 1)}; tail -n 80 \"${d:-${XDG_STATE_HOME:-$HOME/.local/state}/tora}/collect.log\"",
    "purchases": "pnpm --silent --filter @tora/collector-sdk purchases",
    "review": "pnpm --silent --filter @tora/collector-sdk review",
    "import-ai": "pnpm --silent --filter @tora/collector-sdk import-ai",
    "import-uploads": "pnpm --silent --filter @tora/collector-sdk import-uploads",
    "user": "pnpm --silent --filter @tora/db user",
    "catalog:fetch": "pnpm --filter @tora/collectors-public catalog:fetch",
    "catalog:sync": "pnpm --filter @tora/collector-sdk catalog-sync",
    "valuate": "pnpm --filter @tora/db valuate",
    "rebuild": "pnpm --filter @tora/db rebuild",
    "alerts": "pnpm --silent --filter @tora/db alerts",
    "backup": "pnpm --silent --filter @tora/db backup",
    "restore": "pnpm --silent --filter @tora/db restore",
    "demo": "pnpm --silent --filter @tora/collector-sdk demo",
    "mcp": "pnpm --silent --filter @tora/mcp start",
    "plugins": "pnpm --silent --filter @tora/collector-sdk plugins"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tora/collector-sdk": "workspace:*",
    "@tora/core": "workspace:*",
    "@tora/db": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.58.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
