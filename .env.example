# Database (libSQL). Local dev: a SQLite file, relative paths resolve from the repo root.
# Production / collectors writing to the cloud: your Turso URL + token.
DATABASE_URL=file:./data/local.db
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
DATABASE_AUTH_TOKEN=

# Random 32+ byte secret. Generate with: openssl rand -base64 32
# Must be the SAME value here and in the app's environment (on Vercel, or this file on a server):
# it signs sessions and encrypts the authenticator secrets that `pnpm user` writes. Changing it signs everyone out AND requires `pnpm user reset-2fa`
# for every account. To sign everyone out, use `pnpm user revoke <username> all` instead.
AUTH_SECRET=

# eBay Browse API (home PC only, never on Vercel): a production keyset from developer.ebay.com
# (App ID = client ID, Cert ID = client secret). Without them the eBay collector is skipped.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# Cardmarket prices (euros) through TCGdex, for a European market (home PC only). Off by default:
# it searches every English card each night. See docs/sources.md.
# ENABLE_CARDMARKET=1

# Where the daily database backups go (home PC; default ~/.local/share/tora/backups). A synced
# folder (OneDrive, Google Drive) keeps copies off the PC too. See docs/backups.md.
# BACKUP_DIR="/mnt/c/Users/<you>/OneDrive/Tora backups"

# Vercel only: lets Vercel's daily cron run the morning check of alerts (docs/alerts.md).
# CRON_SECRET=
