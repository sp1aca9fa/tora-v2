# Database (libSQL). Local dev: a SQLite file, relative paths resolve from the repo root.
# Production / collectors writing to the cloud: your Turso URL + token.
DATABASE_URL=file:./data/local.db
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
DATABASE_AUTH_TOKEN=

# Random 32+ byte secret. Generate with: openssl rand -base64 32
# Must be the SAME value here and on Vercel: it signs sessions and encrypts the authenticator
# secrets that `pnpm user` writes. Changing it signs everyone out AND requires `pnpm user reset-2fa`
# for every account. To sign everyone out, use `pnpm user revoke <username> all` instead.
AUTH_SECRET=
