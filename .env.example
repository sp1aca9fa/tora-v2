# Database (libSQL). Local dev: a SQLite file, relative paths resolve from the repo root.
# Production / collectors writing to the cloud: your Turso URL + token.
DATABASE_URL=file:./data/local.db
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
DATABASE_AUTH_TOKEN=

# A random secret, at least 32 characters (docs/rules/accounts.md, "Secrets"). Generate with:
# openssl rand -base64 32
# Must be the SAME value here and in the app's environment (on Vercel, or this file on a server):
# it signs sessions and encrypts the authenticator secrets that `pnpm user` writes and the alert
# channels. Changing it signs everyone out AND requires `pnpm user reset-2fa` for every account
# (everything it breaks: docs/rules/accounts.md, "Secrets"). To sign everyone out, use
# `pnpm user revoke <username> all` instead.
AUTH_SECRET=

# eBay Browse API (home PC only, never on Vercel): a production keyset from developer.ebay.com
# (App ID = client ID, Cert ID = client secret). Without them the eBay collector is skipped.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# A second Tora on the same PC: its own folder for the collect log, locks and schedule stamps
# (default ~/.local/state/tora). Set BACKUP_DIR (below) and TORA_ANALYSIS_DB to its own folders
# too, or its backup takes the real one's file name and the real backup is skipped that day
# (docs/running.md).
# TORA_STATE_DIR=/home/<you>/.local/state/tora-test
# TORA_ANALYSIS_DB=/home/<you>/.local/share/tora-test/analysis/tora.db

# Cardmarket prices (euros) through TCGdex, for a European market (home PC only). Off by default:
# it searches every English card each night. See docs/sources.md.
# ENABLE_CARDMARKET=1

# Yahoo! Shopping (game copies by JAN, home PC only): a Client ID from the Yahoo! JAPAN developer
# site. Without it that collector is skipped. See docs/sources.md.
# YAHOO_SHOPPING_CLIENT_ID=

# Where the daily database backups go (home PC; default ~/.local/share/tora/backups). A synced
# folder (OneDrive, Google Drive) keeps copies off the PC too. See docs/backups.md.
# BACKUP_DIR="/mnt/c/Users/<you>/OneDrive/Tora backups"

# A hosted app (Vercel) only: the morning check's daily cron (docs/alerts.md) and the outside
# scheduler calling /api/feed/check (docs/store-feeds.md) send it.
# CRON_SECRET=

# The app opened over plain http from the home network (sign-in cookies without Secure), on your
# own server only. See docs/setup.md.
# TORA_LOCAL_HTTP=1

# A dev server (pnpm dev) also runs the morning check and the store feed checks.
# TORA_DEV_ALERTS=1

# Paid per use (an Anthropic API key): uploaded screenshots are read right away by the Claude API.
# Optional; set in the app's environment (Vercel, or this file on a server). See docs/setup.md.
# ANTHROPIC_API_KEY=

# On a machine that copies a server's backups or reads its status (not the server): its address,
# the read-only token from Settings > Admin > Server, and a Discord webhook link for "server down"
# (docs/home-server.md).
# TORA_STATUS_URL=
# TORA_STATUS_TOKEN=
# TORA_WATCH_DISCORD=

# Other apps on the same server published through the Tailscale Funnel, set up again by
# ops/funnel-check.sh after a reset: <https port>:<local port>, space-separated.
# TORA_OTHER_FUNNELS="8443:3001"

# 0 lets the self-update (ops/update-server.sh --auto) install a commit without waiting for GitHub
# CI to pass on it, for a fork without CI (default: wait for CI). See docs/home-server.md.
# TORA_UPDATE_REQUIRE_CI=0
