{
  "name": "@tora/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./env": "./src/env.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts",
    "./catalog": "./src/catalog.ts",
    "./testing": "./src/testing.ts",
    "./backup": "./src/backup.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "studio": "drizzle-kit studio",
    "user": "tsx src/scripts/user.ts",
    "catalog:sync": "tsx src/scripts/catalog-sync.ts",
    "valuate": "tsx src/scripts/valuate.ts",
    "rebuild": "tsx src/scripts/rebuild.ts",
    "alerts": "tsx src/scripts/alerts.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tora/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "@tora/auth": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "@types/qrcode": "^1.5.6"
  }
}
